# Copy to .env only if it does not already exist. Do not commit .env.
HINDSIGHT_VERSION=latest

# ChatGPT subscription OAuth; no OpenAI Platform API key is needed.
# Login entirely in Docker: docker compose run --rm --service-ports hindsight-login
HINDSIGHT_API_LLM_PROVIDER=chatgpt
# Empty means use Hindsight's default model for the selected provider.
HINDSIGHT_API_LLM_MODEL=
HINDSIGHT_API_LLM_API_KEY=

# Local Hindsight API token, NOT a ChatGPT/OpenAI credential.
# Generate with: openssl rand -hex 32
# Use the same value as HINDSIGHT_API_KEY in Hermes.
HINDSIGHT_API_KEY=
