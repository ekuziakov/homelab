# Generate a secret with: openssl rand -hex 32
SECRET=replace_with_generated_secret
# Movie and TV metadata: https://www.themoviedb.org/settings/api
TMDB_API=api_key
# Set to False after creating your account.
REGISTRATION=True
# Floppy Settings -> Integrations -> API Token (used by the HTTP MCP service).
FLOPPY_TOKEN=replace_with_your_api_token
